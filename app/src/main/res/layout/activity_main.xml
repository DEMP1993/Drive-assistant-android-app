<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Titelzeile mit Hilfe-Knopf -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHelp"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/btn_help" />
        </LinearLayout>

        <!-- Schritt 1: Benachrichtigungszugriff -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/dotStep1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step1"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotifStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_missing"
            android:paddingStart="26dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_notif_access" />

        <!-- Schritt 2: BLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="24dp">

            <TextView
                android:id="@+id/dotStep2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step2"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ble_disconnected"
            android:paddingStart="26dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect" />

        <!-- Schritt 3: Maps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="24dp">

            <TextView
                android:id="@+id/dotStep3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_dot"
                android:textSize="18sp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step3"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLastSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_sent_none"
            android:paddingStart="26dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/btn_test" />

    </LinearLayout>
</ScrollView>
